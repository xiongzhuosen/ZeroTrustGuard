[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=09/19/2026,4.0.0.0
CatalogFile=ZeroTrustGuardDrv.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
ZeroTrustGuardDrv.sys = 1,,

[Manufacturer]
%ProviderName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceDesc%=ZeroTrustGuardInstall,Root\ZeroTrustGuardDrv

[ZeroTrustGuardInstall.NT]
CopyFiles=Files.Driver

[Files.Driver]
ZeroTrustGuardDrv.sys,,,0x00000002

[ZeroTrustGuardInstall.NT.Services]
AddService=ZeroTrustGuardDrv,,ZeroTrustGuardService

[ZeroTrustGuardService]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\ZeroTrustGuardDrv.sys

[Strings]
ProviderName="ZeroTrust"
DeviceDesc="ZeroTrustGuard Kernel Driver"
ServiceName="ZeroTrustGuard Kernel Driver"
DiskName="ZeroTrustGuard Installation Disk"
